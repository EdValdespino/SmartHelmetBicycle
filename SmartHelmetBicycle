#include <esp_now.h>
#include <WiFi.h>

uint8_t macReceptor[] = {0x9C, 0xCC, 0x01, 0x7C, 0x46, 0x3C};

// Pines más seguros para el C3 SuperMini
const int btnIzq = 0;
const int btnDer = 1;
const int btnCancelar = 2;
const int btnLampara = 3;
const int btnHazard = 4;

bool estadoAnteriorIzq = HIGH, estadoAnteriorDer = HIGH;
bool estadoAnteriorCan = HIGH, estadoAnteriorLamp = HIGH, estadoAnteriorHaz = HIGH;

typedef struct mensaje_control {
  bool clickIzq;
  bool clickDer;
  bool clickCancelar;
  bool clickLampara;
  bool clickHazard;
} mensaje_control;

mensaje_control datosEnviar;
esp_now_peer_info_t infoReceptor;

void alEnviarDatos(const uint8_t *mac_addr, esp_now_send_status_t status) {
  // Función de confirmación silenciosa
}

void setup() {
  Serial.begin(115200);
  
  pinMode(btnIzq, INPUT_PULLUP);
  pinMode(btnDer, INPUT_PULLUP);
  pinMode(btnCancelar, INPUT_PULLUP);
  pinMode(btnLampara, INPUT_PULLUP);
  pinMode(btnHazard, INPUT_PULLUP);

  WiFi.mode(WIFI_MODE_STA);
  esp_now_init();
  esp_now_register_send_cb((esp_now_send_cb_t)alEnviarDatos);

  memcpy(infoReceptor.peer_addr, macReceptor, 6);
  infoReceptor.channel = 0;  
  infoReceptor.encrypt = false;
  esp_now_add_peer(&infoReceptor);
}

void loop() {
  bool actualIzq = digitalRead(btnIzq);
  bool actualDer = digitalRead(btnDer);
  bool actualCan = digitalRead(btnCancelar);
  bool actualLamp = digitalRead(btnLampara);
  bool actualHaz = digitalRead(btnHazard);

  bool enviar = false;
  datosEnviar = {false, false, false, false, false};

  if (actualIzq == LOW && estadoAnteriorIzq == HIGH) { datosEnviar.clickIzq = true; enviar = true; }
  if (actualDer == LOW && estadoAnteriorDer == HIGH) { datosEnviar.clickDer = true; enviar = true; }
  if (actualCan == LOW && estadoAnteriorCan == HIGH) { datosEnviar.clickCancelar = true; enviar = true; }
  if (actualLamp == LOW && estadoAnteriorLamp == HIGH) { datosEnviar.clickLampara = true; enviar = true; }
  if (actualHaz == LOW && estadoAnteriorHaz == HIGH) { datosEnviar.clickHazard = true; enviar = true; }

  if (enviar) {
    esp_now_send(macReceptor, (uint8_t *) &datosEnviar, sizeof(datosEnviar));
    delay(200); 
  }

  estadoAnteriorIzq = actualIzq;
  estadoAnteriorDer = actualDer;
  estadoAnteriorCan = actualCan;
  estadoAnteriorLamp = actualLamp;
  estadoAnteriorHaz = actualHaz;

  delay(10);
}
