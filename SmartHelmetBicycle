#include <esp_now.h>
#include <WiFi.h>

uint8_t receiverMac[] = {0x9C, 0xCC, 0x01, 0x7C, 0x46, 0x3C};

// Pins for buttons
const int btnLeft = 0;
const int btnRight = 1;
const int btnCancel = 2;
const int btnLamp = 3;
const int btnHazard = 4;

// Previous state variables to detect clicks
bool prevLeft = HIGH, prevRight = HIGH;
bool prevCancel = HIGH, prevLamp = HIGH, prevHazard = HIGH;

// Data structure (Must match the receiver exactly)
typedef struct control_message {
  bool clickLeft;
  bool clickRight;
  bool clickCancel;
  bool clickLamp;
  bool clickHazard;
} control_message;

control_message sendData;
esp_now_peer_info_t peerInfo;

void onDataSent(const uint8_t *mac_addr, esp_now_send_status_t status) {
  // Silent confirmation
}

void setup() {
  Serial.begin(115200);
  
  pinMode(btnLeft, INPUT_PULLUP);
  pinMode(btnRight, INPUT_PULLUP);
  pinMode(btnCancel, INPUT_PULLUP);
  pinMode(btnLamp, INPUT_PULLUP);
  pinMode(btnHazard, INPUT_PULLUP);

  WiFi.mode(WIFI_MODE_STA);
  esp_now_init();
  esp_now_register_send_cb((esp_now_send_cb_t)onDataSent);

  memcpy(peerInfo.peer_addr, receiverMac, 6);
  peerInfo.channel = 0;  
  peerInfo.encrypt = false;
  esp_now_add_peer(&peerInfo);
}

void loop() {
  bool currLeft = digitalRead(btnLeft);
  bool currRight = digitalRead(btnRight);
  bool currCancel = digitalRead(btnCancel);
  bool currLamp = digitalRead(btnLamp);
  bool currHazard = digitalRead(btnHazard);

  bool sendFlag = false;
  sendData = {false, false, false, false, false};

  if (currLeft == LOW && prevLeft == HIGH) { sendData.clickLeft = true; sendFlag = true; }
  if (currRight == LOW && prevRight == HIGH) { sendData.clickRight = true; sendFlag = true; }
  if (currCancel == LOW && prevCancel == HIGH) { sendData.clickCancel = true; sendFlag = true; }
  if (currLamp == LOW && prevLamp == HIGH) { sendData.clickLamp = true; sendFlag = true; }
  if (currHazard == LOW && prevHazard == HIGH) { sendData.clickHazard = true; sendFlag = true; }

  if (sendFlag) {
    esp_now_send(receiverMac, (uint8_t *) &sendData, sizeof(sendData));
    delay(200); // Debounce delay
  }

  prevLeft = currLeft;
  prevRight = currRight;
  prevCancel = currCancel;
  prevLamp = currLamp;
  prevHazard = currHazard;

  delay(10);
}
